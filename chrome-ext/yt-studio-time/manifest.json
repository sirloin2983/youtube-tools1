{
  "manifest_version": 3,
  "name": "YouTube Studio 投稿時刻",
  "version": "0.1.0",
  "description": "YouTube Studio のコンテンツ一覧の「日付」の欄に、公開(投稿)した時刻を足す。外部との通信は無い",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
